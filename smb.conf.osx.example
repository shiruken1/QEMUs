# Reference Homebrew Samba config for the QEMU Windows VM (macOS host).
#
# You normally do NOT edit this file. `./samba-osx.sh config` generates the real
# config at $(brew --prefix)/etc/smb.conf for your user and share path. This file
# documents what that output looks like. Replace YOUR_USER / YOUR_SHARE_PATH and
# the Homebrew prefix (/opt/homebrew on Apple Silicon, /usr/local on Intel) if
# you ever hand-write it.
#
# Requires Samba 4.16.4 (see samba-4.16.4.rb). Samba >= 4.17 breaks guest writes
# over QEMU SMB on macOS (NT_STATUS_ACCESS_DENIED).
#
# Share appears in Windows as \\10.0.2.2\samba (guest access, no credentials).

[global]
   workgroup = WORKGROUP
   server role = standalone server
   interfaces = 127.0.0.1
   bind interfaces only = yes

   private dir = /opt/homebrew/var/lib/samba/private
   state directory = /opt/homebrew/var/lib/samba
   lock directory = /opt/homebrew/var/lib/samba/lock
   cache directory = /opt/homebrew/var/lib/samba/cache
   ncalrpc dir = /opt/homebrew/var/lib/samba/ncalrpc
   pid directory = /opt/homebrew/var/lib/samba
   smb passwd file = /opt/homebrew/var/lib/samba/private/smbpasswd

   log file = /opt/homebrew/var/log/samba/log.%m
   logging = file

   security = user
   map to guest = Bad User
   usershare allow guests = yes
   load printers = no
   printing = bsd
   disable spoolss = yes
   usershare max shares = 0

   # Required for Windows clients (VS/MSBuild). Conflicts with unix extensions.
   unix extensions = no
   ea support = yes
   store dos attributes = yes
   acl allow execute always = yes
   strict locking = no
   # macOS/APFS parity with Linux ext4 for MSBuild write/rename/lock patterns.
   posix locking = no
   strict sync = no
   fruit:aapl = yes
   fruit:nfs_aces = no
   fruit:metadata = stream
   fruit:resource = file

[samba]
   comment = QEMU shared folder
   path = /Users/YOUR_USER/Documents/BuildTrue
   browsable = yes
   available = yes
   public = yes
   guest ok = yes
   guest only = yes
   read only = no
   writable = yes
   force user = YOUR_USER
   create mask = 0775
   directory mask = 0775
   force create mode = 0777
   force directory mode = 0777
   # catia+fruit+streams_xattr = recommended macOS host stack (handles ._ files, xattrs).
   vfs objects = catia fruit streams_xattr
   oplocks = no
   level2 oplocks = no
   kernel oplocks = no
   posix locking = no
